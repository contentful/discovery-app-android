<?xml version="1.0" encoding="utf-8"?>

<merge xmlns:android="http://schemas.android.com/apk/res/android"
             xmlns:tools="http://schemas.android.com/tools">

    <ImageView
        android:id="@+id/iv_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <ScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/tom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusableInTouchMode="true"
            android:orientation="vertical"
            android:padding="25dp">

            <com.contentful.discovery.widget.CFTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="Discovery App"
                android:textAllCaps="true"
                android:textColor="@android:color/white"
                android:textSize="18sp"/>

            <ImageView
                android:id="@+id/iv_logo"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="62dp"
                android:layout_marginTop="62dp"
                tools:src="@drawable/logo_contentful"/>

            <com.contentful.discovery.widget.CFTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:text="Access your space"/>

            <com.contentful.discovery.widget.ClearableEditText
                android:id="@+id/et_space"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:hint="@string/credentials_space"
                android:inputType="textNoSuggestions"
                android:singleLine="true"/>

            <com.contentful.discovery.widget.ClearableEditText
                android:id="@+id/et_token"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="@string/credentials_access_token"
                android:inputType="textNoSuggestions"
                android:imeOptions="actionDone"
                android:singleLine="true"/>

            <com.contentful.discovery.widget.CFButton
                android:id="@+id/btn_go"
                style="@style/CFButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Open space"/>

            <View
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:minHeight="20dp"
                android:layout_weight="1"/>

            <com.contentful.discovery.widget.CFButton
                android:id="@+id/btn_secondary"
                style="@style/CFButton.Inverse"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Open demo space"/>

            <com.contentful.discovery.widget.CFTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="25dp"
                android:text="Need help?"/>

        </LinearLayout>

    </ScrollView>

</merge>
