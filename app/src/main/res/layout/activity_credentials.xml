<?xml version="1.0" encoding="utf-8"?>

<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <ScrollView
        android:id="@+id/sv_main"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/wrapper_main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:focusableInTouchMode="true">

            <!-- Dimensions for this view will be set at runtime, see CredentialsActivity.java -->
            <ImageView
                android:id="@+id/iv_logo"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_gravity="center_horizontal"
                android:padding="25dp"
                tools:src="@drawable/logo_contentful" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:text="@string/credentials_api_credentials"
                    android:textAllCaps="true"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btn_history"
                    style="@style/FloatingButton.Round"
                    android:layout_gravity="end|center_vertical"
                    android:src="@drawable/ic_history" />

            </FrameLayout>

            <EditText
                android:id="@+id/et_space"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/credentials_space"
                android:singleLine="true"
                style="@style/CFEditText" />

            <EditText
                android:id="@+id/et_token"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/credentials_access_token"
                android:singleLine="true"
                style="@style/CFEditText" />

            <Button
                android:id="@+id/btn_start"
                style="@style/FloatingButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/credentials_start" />

        </LinearLayout>

    </ScrollView>

    <FrameLayout
        android:id="@+id/wrapper_history"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="invisible">

        <fragment android:name="com.contentful.discovery.fragments.HistoryFragment"
            android:id="@+id/fragment_history"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            tools:layout="@layout/fragment_history"/>

    </FrameLayout>

</merge>

